# =============================================================================
# EventShare LOCAL DEMO environment (docs/DEMO.md)
#
#   1. Run scripts/demo-up.ps1 (Windows) or scripts/demo-up.sh (macOS/Linux).
#      The first run copies this file to .env.demo (git-ignored) and generates
#      every value marked GENERATED.
#   2. Paste your Clerk TEST keys and a demo R2 bucket's keys where marked PASTE.
#   3. Run the script again. It starts the stack on http://localhost:8090 and
#      prints the demo logins.
#
# Never put production keys here. Use a Clerk *development* instance and a
# separate R2 bucket (for example "eventshare-demo") so demo data never mixes
# with real data and the nightly reset can never touch production.
# =============================================================================

# ---- URLs (local demo stack on port 8090, beside the dev stack on 8088) ----
EVENTSHARE_HTTP_PORT=8090
APP_BASE_URL=http://localhost:8090
NEXT_PUBLIC_APP_BASE_URL=http://localhost:8090
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090/api
CORS_ALLOWED_ORIGINS=http://localhost:8090

# ---- PostgreSQL (separate volume: compose project "eventshare-demo") ----
POSTGRES_DB=eventshare
POSTGRES_USER=eventshare
POSTGRES_PASSWORD=GENERATED
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/eventshare
SPRING_DATASOURCE_USERNAME=eventshare
SPRING_DATASOURCE_PASSWORD=GENERATED

# ---- Clerk TEST instance (dashboard.clerk.com > your dev instance > API keys) ----
# In the Clerk dashboard (User & authentication): enable Username and Password, and
# make Email address optional. The demo accounts sign in with username + password.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=PASTE_pk_test_key
CLERK_SECRET_KEY=PASTE_sk_test_key
CLERK_ISSUER=https://PASTE-your-subdomain.clerk.accounts.dev
CLERK_JWKS_URL=https://PASTE-your-subdomain.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Cloudflare R2: a SEPARATE demo bucket ----
# The bucket needs a CORS rule allowing PUT and GET from http://localhost:8090.
R2_ENDPOINT=https://PASTE-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=PASTE_r2_access_key_id
R2_SECRET_ACCESS_KEY=PASTE_r2_secret_access_key
R2_BUCKET=eventshare-demo
R2_PRESIGN_UPLOAD_TTL_SECONDS=900
R2_PRESIGN_DOWNLOAD_TTL_SECONDS=3600

# ---- Demo mode ----
DEMO_ENABLED=true
# Sign-in names shown to interviewers. Emails are optional; leave them blank for a
# username-only login. (If your Clerk instance insists on an email, use a Clerk test
# address such as demo.host+clerk_test@example.com: no mail is sent, code 424242.)
DEMO_HOST_USERNAME=demo-host
DEMO_HOST_EMAIL=
DEMO_HOST_PASSWORD=GENERATED
DEMO_HOST_NAME=Demo Host
# A local demo has no real users, so the demo admin is safe to enable here.
DEMO_ADMIN_ENABLED=true
DEMO_ADMIN_USERNAME=demo-admin
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=GENERATED
DEMO_ADMIN_NAME=Demo Admin
DEMO_INVITE_CODE=EVENTSHARE
DEMO_SECONDARY_INVITE_CODE=TEAMDAY26X
DEMO_PROMO_CODE=INTERVIEW30
DEMO_PHOTO_COUNT=18
DEMO_RESET_CRON=0 0 4 * * *
DEMO_RESET_ZONE=America/Chicago
# Show the demo logins on the landing page (fine for a local demo).
DEMO_SHOW_CREDENTIALS=true
# Public demo guardrails. Set DEMO_GUEST_UPLOADS_ENABLED=false for a read-only demo.
DEMO_GUEST_UPLOADS_ENABLED=true
DEMO_MAX_GUEST_UPLOADS=8
# Per visitor (client IP) within the shared total above.
DEMO_MAX_GUEST_UPLOADS_PER_IP=4
DEMO_MAX_GUEST_UPLOAD_BYTES=26214400

# ---- Admin bootstrap ----
# The demo admin gets the ADMIN role from the seeder; no entry needed here.
ADMIN_EMAILS=
ADMIN_CLERK_USER_IDS=
DEMO_EMAILS=

# ---- Media limits ----
MEDIA_MAX_UPLOAD_BYTES=104857600
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/heic,image/gif,video/mp4,video/quicktime,video/webm

# ---- Stripe test mode (optional; paid checkout is unavailable without it) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_WEDDING_PRO=
STRIPE_PRICE_LIFETIME=
BILLING_SUCCESS_URL=http://localhost:8090/dashboard?billing=success
BILLING_CANCEL_URL=http://localhost:8090/pricing?billing=cancel

# ---- Misc ----
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms96m -Xmx384m -XX:+UseSerialGC
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERATED
